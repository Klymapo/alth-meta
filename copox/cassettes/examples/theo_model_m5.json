{
  "id": "theo-model-m5",
  "kind": "alth_model_m5",
  "profile": "copox/profiles/alth_model_m5.json",
  "target": "joven_rubio",
  "baseline": "copox/baselines/joven_rubio_alpha.json",
  "maturity": {
    "coverage": "copox/maturity/theo.json",
    "production_policy": "copox/production/theo_m5_policy.json",
    "min_level": "M5",
    "critical_only": true,
    "block_execution": true
  },
  "variables": {
    "baseline_params": "copox/baselines/joven_rubio_alpha.json",
    "baseline_model": "assets/joven_rubio/theo_alpha.glb",
    "state_branch": "copox/state/theo-character",
    "reference": "refs/personajes/joven-rubio-4-vistas.jpg",
    "audit_config": "copox/reference_configs/joven_rubio_alpha.json",
    "production_policy": "copox/production/theo_m5_policy.json"
  },
  "strategy": {
    "tournament_size": 3,
    "max_candidates": 6
  },
  "commands": {
    "prepare": ["python3", "-m", "copox.adapters.alth_model_m5_cycle", "prepare", "--repo-root", "{repo_root}", "--baseline-params", "{baseline_params}", "--baseline-model", "{baseline_model}", "--state-branch", "{state_branch}", "--reference", "{reference}", "--config", "{audit_config}", "--policy", "{production_policy}", "--run-dir", "{run_dir}"],
    "mutate": ["python3", "-m", "copox.adapters.alth_model_m5_cycle", "mutate", "--run-dir", "{run_dir}", "--candidate-dir", "{candidate_dir}", "--candidate-id", "{candidate_id}"],
    "capture": ["python3", "-m", "copox.adapters.alth_model_m5_cycle", "capture", "--repo-root", "{repo_root}", "--run-dir", "{run_dir}", "--candidate-dir", "{candidate_dir}", "--evidence-dir", "{evidence_dir}", "--reference", "{reference}", "--config", "{audit_config}", "--policy", "{production_policy}"],
    "learn": ["python3", "-m", "copox.adapters.alth_model_m5_cycle", "learn", "--repo-root", "{repo_root}", "--run-dir", "{run_dir}", "--tournament", "{tournament}", "--state-branch", "{state_branch}", "--cassette-id", "{cassette_id}", "--target", "{target}", "--config", "{audit_config}", "--policy", "{production_policy}"],
    "promote": ["python3", "-m", "copox.adapters.alth_model_m5_cycle", "promote", "--repo-root", "{repo_root}", "--candidate-dir", "{candidate_dir}", "--baseline-params", "{baseline_params}", "--state-branch", "{state_branch}", "--cassette-id", "{cassette_id}", "--target", "{target}"]
  },
  "promotion": {
    "unanimous": true
  },
  "reporting": {
    "required_evidence": ["gate.json", "module_result.json", "*.png"],
    "publish_only_unanimous": true
  }
}
